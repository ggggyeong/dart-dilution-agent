# 이 파일을 .env로 복사해 값을 채운다. .env는 git에 올리지 않는다.
# 형식: KEY=값 (= 앞뒤, 값 끝에 공백 없이)

# OpenDART — https://opendart.fss.or.kr 에서 발급
DART_API_KEY=

# B001 수집 기간과 분석 시작일 (YYYY-MM-DD) — 주석이면 아래 값
# COLLECT_START_DATE=2023-04-16
# COLLECT_END_DATE=2026-10-15
# ANALYSIS_START_DATE=2023-10-16

# PostgreSQL — 비워 두면 docker-compose.yml 기본값(filingscope) 사용
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=filingscope
POSTGRES_PASSWORD=filingscope
POSTGRES_DB=filingscope

# LLM — Event Agent의 LLM 읽기·요약 단계부터 필요
ANTHROPIC_API_KEY=

# KRX 정보데이터시스템(data.krx.co.kr) 계정 — pykrx의 지수·시가총액·종목 목록에 필요
KRX_ID=
KRX_PW=

# OpenAI — RAG 조각 · 질문 임베딩 (text-embedding-3-small, scripts/embed_chunks.py · search_filing_text)
OPENAI_API_KEY=
